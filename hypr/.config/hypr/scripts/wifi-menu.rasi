* {
    font: "CaskaydiaCove Nerd Font 13";
    bg: rgba(10, 10, 10, 95%);
    fg: #d4d4d4;
    fg-muted: #666666;
    accent: #ffa032;
    accent-bg: rgba(255, 160, 50, 20%);
    accent-border: rgba(255, 160, 50, 30%);
    surface: rgba(255, 255, 255, 4%);
    urgent: #cc4444;
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @accent-border;
    border-radius: 4px;
    width: 320px;
    location: north east;
    anchor: north east;
    y-offset: 4px;
}

mainbox {
    background-color: transparent;
    spacing: 4px;
    padding: 8px;
}

inputbar {
    background-color: @surface;
    text-color: @fg;
    border-radius: 4px;
    padding: 6px 10px;
    spacing: 8px;
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg-muted;
}

listbox {
    background-color: transparent;
    spacing: 2px;
}

listview {
    background-color: transparent;
    lines: 10;
    fixed-height: false;
    spacing: 2px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 4px;
    padding: 4px 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element selected.normal {
    background-color: @accent-bg;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: none;
}
