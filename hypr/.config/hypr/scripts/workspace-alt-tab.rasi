* {
    font: "CaskaydiaCove Nerd Font 11";
    bg: rgba(10, 10, 10, 95%);
    fg: #d4d4d4;
    fg-muted: #666666;
    accent: #ffa032;
    accent-bg: rgba(255, 160, 50, 15%);
    accent-border: rgba(255, 160, 50, 40%);
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @accent-border;
    border-radius: 8px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
    padding: 12px;
}

inputbar {
    enabled: false;
}

listview {
    background-color: transparent;
    flow: horizontal;
    columns: 5;
    lines: 2;
    fixed-height: false;
    fixed-columns: true;
    spacing: 8px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 6px;
    padding: 8px;
    orientation: vertical;
    spacing: 4px;
    children: [ element-icon, element-text ];
}

element-icon {
    background-color: transparent;
    size: 192px 120px;
    border-radius: 4px;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: none;
    horizontal-align: 0.5;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent-bg;
    text-color: @accent;
    border: 2px;
    border-color: @accent-border;
}
