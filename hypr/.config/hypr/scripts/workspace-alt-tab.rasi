* {
    font: "CaskaydiaCove Nerd Font 14";
    bg: rgba(10, 10, 10, 95%);
    fg: #d4d4d4;
    fg-muted: #666666;
    accent: #ffa032;
    accent-bg: rgba(255, 160, 50, 20%);
    accent-border: rgba(255, 160, 50, 30%);
    surface: rgba(255, 255, 255, 4%);
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @accent-border;
    border-radius: 8px;
    width: 280px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
    spacing: 0px;
    padding: 8px;
}

inputbar {
    enabled: false;
}

listview {
    background-color: transparent;
    lines: 8;
    fixed-height: false;
    spacing: 2px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 4px;
    padding: 6px 10px;
    orientation: horizontal;
    spacing: 10px;
    children: [ element-icon, element-text ];
}

element-icon {
    background-color: transparent;
    size: 48px 27px;
    border-radius: 2px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: none;
    vertical-align: 0.5;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent-bg;
    text-color: @accent;
    border: 1px;
    border-color: @accent-border;
}
